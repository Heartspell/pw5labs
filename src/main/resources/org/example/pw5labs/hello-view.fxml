<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.pw5labs.SalaryController"
      spacing="12"
      stylesheets="@style.css">
    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>

    <VBox styleClass="header" spacing="4">
        <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>
        <Label text="Лабораторная работа №1" styleClass="eyebrow"/>
        <Label text="Расчёт заработной платы" styleClass="title"/>
        <Label text="PostgreSQL" styleClass="subtitle"/>
    </VBox>

    <GridPane hgap="8" vgap="8">
        <Label text="Премия, %" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="benefitMoneyField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        <Label text="Подоходный налог, %" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
        <TextField fx:id="profitTaxField" GridPane.rowIndex="0" GridPane.columnIndex="3"/>
        <Label text="Профсоюзный взнос, %" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="profTaxField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        <Label text="Социальный фонд, %" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
        <TextField fx:id="retirementTaxField" GridPane.rowIndex="1" GridPane.columnIndex="3"/>
        <Label text="Календарных дней" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="calendarDaysField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
        <Label text="Рабочих дней" GridPane.rowIndex="2" GridPane.columnIndex="2"/>
        <TextField fx:id="workDaysField" GridPane.rowIndex="2" GridPane.columnIndex="3"/>
        <Label text="Дата выплаты" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <DatePicker fx:id="dateField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
        <Button fx:id="countButton" text="Рассчитать" onAction="#countSalaries" styleClass="primary-button" GridPane.rowIndex="3" GridPane.columnIndex="3"/>
    </GridPane>

    <HBox spacing="8">
        <Label text="Всего выплачено:" styleClass="total-label"/>
        <TextField fx:id="totalPaidField" editable="false" styleClass="total-field"/>
    </HBox>

    <TableView fx:id="paymentsTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="idColumn" text="№" prefWidth="45"/>
            <TableColumn fx:id="nameColumn" text="ФИО" prefWidth="170"/>
            <TableColumn fx:id="cityColumn" text="Город" prefWidth="100"/>
            <TableColumn fx:id="phoneColumn" text="Телефон" prefWidth="125"/>
            <TableColumn fx:id="positionColumn" text="Должность" prefWidth="150"/>
            <TableColumn fx:id="salaryColumn" text="Оклад" prefWidth="100"/>
            <TableColumn fx:id="taxColumn" text="Налоги, %" prefWidth="90"/>
            <TableColumn fx:id="dateColumn" text="Дата" prefWidth="105"/>
            <TableColumn fx:id="totalColumn" text="К выплате" prefWidth="115"/>
        </columns>
    </TableView>
</VBox>
